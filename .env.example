# ==============================================================================
# Environment Configuration Template - AI Chatbot MVP & Agentic RAG
# Target System: Ubuntu 22.04.5 LTS & Docker 29.9.1 (Compose V2)
#
# Port Bindings (Strictly bound to 127.0.0.1 for server security):
# - Frontend Web:    127.0.0.1:8080
# - Backend API:     127.0.0.1:8000
# - PostgreSQL:      127.0.0.1:5432
# - MinIO S3 API:    127.0.0.1:9000
# - MinIO Web GUI:   127.0.0.1:9001
# - n8n Automation:  127.0.0.1:5678
# - Ollama LLM:      127.0.0.1:11434
# ==============================================================================

# Application Meta
APP_NAME=AI Chatbot MVP
NODE_ENV=production
GENERIC_TIMEZONE=Asia/Jakarta

# 1. Frontend Web Configuration
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_OLLAMA_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=qwen2.5:3b

# 2. Backend API Configuration (FastAPI)
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# 3. PostgreSQL Database with PGVector Extension
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_IMAGE=pgvector/pgvector:pg17

# 4. MinIO S3-Compatible Object Storage
MINIO_BIND_IP=127.0.0.1
S3_PORT=9000
S3_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin123

# 5. n8n Workflow Automation
N8N_BIND_IP=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=n8nSecretKeyEncryption2026Secure!

# 6. Local LLM Service (Ollama with Qwen 2.5: 3B)
OLLAMA_BIND_IP=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=24h
OLLAMA_BASE_URL=http://ollama:11434