# ==============================================================================
# Environment Configuration - AI Chatbot MVP
# For Ubuntu 22.04.5 LTS & Docker 29.9.1
# ==============================================================================

# Web Frontend
APP_NAME="AI Chatbot MVP"
WEB_PORT=3000
API_BASE_URL=

# Database (PostgreSQL 17 with PGVector)
POSTGRES_DB=ai_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# MinIO Object Storage (S3 Compatible)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin123
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Workflow Automation (n8n)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Jakarta
N8N_ENCRYPTION_KEY=n8nSecretKeyEncryption2026Secure!

# AI / Gemini API (Optional for cloud LLM features)
GEMINI_API_KEY=