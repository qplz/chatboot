# ==============================================================================
# Environment Configuration Template - AI Chatbot MVP
# Target System: Ubuntu 22.04.5 LTS & Docker 29.9.1 (Compose V2)
#
# Port Bindings (Isolated to localhost 127.0.0.1):
# - Frontend:    http://127.0.0.1:8080
# - Backend:     http://127.0.0.1:8000 (Swagger docs at /docs)
# - PostgreSQL:  127.0.0.1:5432
# - MinIO:       127.0.0.1:9000 (S3 API) & 127.0.0.1:9001 (Console GUI)
# - n8n:         http://127.0.0.1:5678
# - Ollama LLM:  http://127.0.0.1:11434 (Model: qwen2.5:3b)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Service (React SPA + Nginx)
# ------------------------------------------------------------------------------
APP_NAME="AI Chatbot MVP"
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
API_BASE_URL=http://127.0.0.1:8000
VITE_OLLAMA_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# 2. Backend API Service (FastAPI + Python 3.12)
# ------------------------------------------------------------------------------
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL 17 with PGVector Extension)
# ------------------------------------------------------------------------------
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ------------------------------------------------------------------------------
# 4. Object Storage: MinIO (S3 Compatible Storage)
# ------------------------------------------------------------------------------
MINIO_BIND_IP=127.0.0.1
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin123
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 5. Workflow Automation Engine (n8n)
# ------------------------------------------------------------------------------
N8N_BIND_IP=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Jakarta
N8N_ENCRYPTION_KEY=n8nSecretKeyEncryption2026Secure!

# ------------------------------------------------------------------------------
# 6. Local LLM Service: Ollama & Qwen 2.5
# ------------------------------------------------------------------------------
OLLAMA_BIND_IP=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=24h

# ------------------------------------------------------------------------------
# 7. Cloud AI Fallback (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=