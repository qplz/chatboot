# =============================================================
# AI Chatbot MVP — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# =============================================================

# Application
APP_ENV=development
APP_NAME=ai-chatbot-mvp
APP_SECRET_KEY=replace-with-a-long-random-secret-min-32-chars
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=ai_chatbot
POSTGRES_USER=ai_chatbot_app
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+asyncpg://ai_chatbot_app:replace-with-a-strong-password@postgres:5432/ai_chatbot

# Authentication
JWT_SECRET_KEY=replace-with-a-different-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM (use "mock" for local dev without API key)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Embedding (use "mock" for local dev)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIMENSION=384

# OCR and ingestion
OCR_PROVIDER=paddleocr
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5

# n8n
N8N_VERSION=1.70.3
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret-for-n8n
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_API_BASE_URL=http://n8n:5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Jakarta

# Storage
STORAGE_BACKEND=local
UPLOAD_DIR=/app/data/uploads

# MinIO (optional, activate with --profile object-storage)
MINIO_VERSION=RELEASE.2024-11-07T00-52-20Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ai-chatbot-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=ai-chatbot-api
